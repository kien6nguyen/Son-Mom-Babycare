# SÕN - Mom & Babycare Backend

PORT=5000
NODE_ENV=development
ADMIN_API_KEY=SON~@123

# ========================================
# Database Mode: "local" hoặc "supabase"
# ========================================
DB_MODE=local

# --- Local PostgreSQL (Docker) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=son_babycare
DB_USER=son_admin
DB_PASSWORD=son_secret_2026

# --- Supabase (Production) ---
# Khi chuyển sang production, đổi DB_MODE=supabase và điền thông tin bên dưới
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (SMTP) - Tùy chọn
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
CONTACT_EMAIL=hello@sonbabycare.vn

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173
